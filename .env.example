# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Every variable is optional. Settings are read in this order, first match wins:
# -D system properties, environment variables, .env, then src/main/resources/config/defaults.properties.

# --- Application under test ---------------------------------------------------
# Leave BASE_URL empty to run against the bundled demo app (started automatically).
BASE_URL=
# API base URL, if different from BASE_URL
API_BASE_URL=
# Environment label (local, qa, staging, ...)
TEST_ENV=local

# Login used by the login, @authenticated and API scenarios. Not needed for the demo app.
APP_USERNAME=
APP_PASSWORD=

# --- Browser ------------------------------------------------------------------
# chrome | firefox | edge (Selenium Manager downloads the driver, and the browser if missing)
TEST_BROWSER=chrome
# Defaults to true when CI is set, false locally
HEADLESS=
# Browser window size
WINDOW_SIZE=1280x720
# Run on a Selenium Grid instead of a local browser, e.g. http://localhost:4444
SELENIUM_REMOTE_URL=
# Timeouts in milliseconds: explicit waits in page objects and steps, and page loads
WAIT_TIMEOUT=10000
PAGE_LOAD_TIMEOUT=30000

# --- Database (enables @db scenarios when DB_HOST is set) ---------------------
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Demo app (./mvnw exec:java) ------------------------------------------------
# 0.0.0.0 to accept connections from other containers
DEMO_APP_HOST=127.0.0.1
DEMO_APP_PORT=4173

# Parallel scenarios and retries are Maven properties, not variables:
#   ./mvnw verify -Dworkers=2 -Dretries=1
